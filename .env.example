# Server Configuration
PORT=3000
NODE_ENV=development

# Security Secret for Cron Jobs (Checked via Bearer token or x-cron-secret header)
CRON_SECRET=your_super_secret_cron_key_here

# DeepInfra AI Configuration for Structured SMS Categorization
# Get your token from https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Google Sheets Webhook URL (from Google Apps Script Deploy as Web App)
GOOGLE_SHEET_WEBHOOK_URL=

# Optional: Telegram Notification Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
