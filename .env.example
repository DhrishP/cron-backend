# Server Configuration
PORT=3000
NODE_ENV=development

# Security Secret for Cron Jobs (e.g. checked in Bearer token or x-cron-secret header)
CRON_SECRET=your_super_secret_cron_key_here

# Optional: Google Sheets Webhook or Service Account (if forwarding to sheet)
GOOGLE_SHEET_WEBHOOK_URL=

# Optional: Telegram Notification Bot (if you want alerts for large expenses)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
